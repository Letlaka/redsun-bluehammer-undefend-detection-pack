// Purpose:
//   Standalone BlueHammer Stage 5c hunt from 01_bluehammer_full_attack_chain.kql.
//   Finds bursts of local account password change or modification events,
//   or the public BlueHammer password marker.

let Lookback = 2h;
let NormalizePath = (FolderPath:string, FileName:string) {
    case(
        isempty(FolderPath), FileName,
        isempty(FileName), FolderPath,
        tolower(FolderPath) endswith strcat(@"\", tolower(FileName)), FolderPath,
        strcat(FolderPath, iff(FolderPath endswith @"\", "", @"\"), FileName)
    )
};
DeviceEvents
| where Timestamp >= ago(Lookback)
| extend AdditionalFieldsText = tostring(AdditionalFields)
| extend HasPublicPasswordMarker = AdditionalFieldsText contains "$PWNed666!!!WDFAIL"
    or InitiatingProcessCommandLine contains "$PWNed666!!!WDFAIL"
| where ActionType in~ ("UserAccountPasswordChanged", "UserAccountModified")
    or HasPublicPasswordMarker
| summarize
    Timestamp = min(Timestamp),
    LastSeen = max(Timestamp),
    PasswordChanges = countif(ActionType in~ ("UserAccountPasswordChanged", "UserAccountModified")),
    MarkerHits = countif(HasPublicPasswordMarker),
    DeviceName = any(DeviceName),
    ReportId = any(ReportId),
    Accounts = make_set(AdditionalFieldsText, 20),
    ProcessCommandLine = any(InitiatingProcessCommandLine),
    AccountName = any(InitiatingProcessAccountName),
    AccountSid = any(InitiatingProcessAccountSid)
  by DeviceId, ProcessName = InitiatingProcessFileName, ProcessPath = InitiatingProcessFolderPath, WindowBucket = bin(Timestamp, 2m)
| where PasswordChanges >= 4 or MarkerHits > 0
| project
    Timestamp,
    DeviceId,
    DeviceName,
    ReportId,
    Stage = "Stage5c_LocalPasswordChangeBurst",
    StageDescription = "Burst of local account password change or modification events within two minutes, or public BlueHammer password marker observed",
    ProcessName,
    ProcessPath = NormalizePath(ProcessPath, ProcessName),
    ProcessCommandLine,
    AccountName,
    AccountSid,
    Evidence = strcat("PasswordChanges=", tostring(PasswordChanges), " | MarkerHits=", tostring(MarkerHits)),
    AdditionalContext = strcat("LastSeen=", tostring(LastSeen), " | Accounts=", tostring(Accounts))
| order by Timestamp desc
